# dbt connection profile. Copy to ~/.dbt/profiles.yml (or set
# DBT_PROFILES_DIR=kara_dbt after copying this to profiles.yml) -- never
# commit the real profiles.yml if you hard-code credentials into it instead
# of using env vars as done here.
kara_dbt:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      user: "{{ env_var('POSTGRES_USER') }}"
      password: "{{ env_var('POSTGRES_PASSWORD') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | as_number }}"
      dbname: "{{ env_var('POSTGRES_DB') }}"
      schema: staging
      threads: 4
