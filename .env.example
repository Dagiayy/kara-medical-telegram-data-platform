# Copy to .env and fill in real values. Never commit the real .env file.

# --- Telegram (get these at https://my.telegram.org) ---
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
# Optional: paste the session string printed after your first interactive
# login (see app/scraper/scrape_telegram.py) to run non-interactively, e.g.
# in Docker or under the Dagster scheduler.
TELEGRAM_SESSION_STRING=
SCRAPE_MESSAGE_LIMIT=200

# --- Postgres ---
# Use POSTGRES_HOST=postgres when running via docker-compose, localhost otherwise.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kara_db
POSTGRES_USER=karauser
POSTGRES_PASSWORD=change_me

# --- Data lake ---
DATA_LAKE_ROOT=data_lake/raw

# --- Object detection ---
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_BATCH_SIZE=16

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- API ---
API_DEFAULT_PAGE_SIZE=20
API_MAX_PAGE_SIZE=200
API_CORS_ORIGINS=*
